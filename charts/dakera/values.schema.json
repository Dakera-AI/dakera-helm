{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dakera Helm Chart Values",
  "description": "Configuration values for the Dakera AI agent memory platform Helm chart",
  "type": "object",
  "properties": {
    "dakera": {
      "type": "object",
      "description": "Dakera server configuration",
      "properties": {
        "image": {
          "type": "object",
          "description": "Container image settings",
          "properties": {
            "repository": {"type": "string", "description": "Image repository"},
            "tag": {"type": "string", "description": "Image tag"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"], "description": "Image pull policy"}
          }
        },
        "replicaCount": {"type": "integer", "minimum": 1, "description": "Number of Dakera server replicas"},
        "rootApiKey": {"type": "string", "description": "Root API key — REQUIRED. Set via --set or external secret."},
        "config": {
          "type": "object",
          "description": "Dakera server runtime configuration",
          "properties": {
            "host": {"type": "string", "description": "Bind address"},
            "port": {"type": "integer", "description": "HTTP port"},
            "grpcPort": {"type": "integer", "description": "gRPC port"},
            "storage": {"type": "string", "enum": ["memory", "filesystem", "s3"], "description": "Storage backend (DAKERA_STORAGE)"},
            "s3Bucket": {"type": "string", "description": "S3 bucket name"},
            "s3Region": {"type": "string", "description": "S3 region"},
            "s3Endpoint": {"type": "string", "description": "Custom S3 endpoint (for MinIO or external providers)"},
            "l1CacheSize": {"type": "string", "description": "DAKERA_L1_CACHE_SIZE: the tiered-storage hot-tier budget. A unit suffix (1GB, 512MB) is bytes; a bare number below 10 million is a vector count"},
            "dataRoot": {"type": "string", "description": "Data root (DAKERA_STORAGE_PATH); every local path derives from it and the persistence volume is mounted here"},
            "tiered": {"type": ["string", "integer", "boolean"], "description": "DAKERA_TIERED: the tiered embedding engine (not tiered storage). \"1\" / true on, \"0\" / false off"},
            "searchMode": {"type": "string", "description": "DAKERA_SEARCH_MODE"},
            "tieredStorage": {"type": "boolean", "description": "Enable tiered storage (hot/warm/cold)"},
            "hotToWarmSecs": {"type": "integer", "description": "Seconds before hot memory moves to warm tier"},
            "warmToColdSecs": {"type": "integer", "description": "Seconds before warm memory moves to cold tier"},
            "autoTier": {"type": "boolean", "description": "Enable automatic tiering"},
            "tierCheckIntervalSecs": {"type": "integer", "description": "Tier check interval in seconds"},
            "maxBodySize": {"type": "string", "description": "Maximum HTTP body size in bytes"},
            "authEnabled": {"type": "boolean", "description": "Enable API key authentication"},
            "rustLog": {"type": "string", "description": "Rust log level (e.g. info, debug, warn)"}
          }
        },
        "cluster": {
          "type": "object",
          "description": "Cluster mode secret (DAKERA_CLUSTER_SECRET, at least 16 characters, identical on every node; required in cluster mode from server 0.12.1)",
          "properties": {
            "secret": {"type": "string", "pattern": "^(|.{16,})$", "description": "Chart-managed secret value, stored in <release>-secrets: empty, or at least 16 characters"},
            "existingSecret": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "description": "Name of a Secret you manage"},
                "key": {"type": "string", "description": "Key in that Secret"}
              }
            }
          }
        },
        "extraEnv": {"type": "array", "description": "Extra environment variables for the Dakera container (Kubernetes EnvVar list)", "items": {"type": "object"}},
        "models": {
          "type": "object",
          "description": "Model cache and pre-pull",
          "properties": {
            "pull": {"type": "array", "items": {"type": "string"}, "description": "Models pulled by an init container (dakera models pull); `configured` = the configured environment"},
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "size": {"type": "string"},
                "storageClass": {"type": "string"},
                "accessMode": {"type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]}
              }
            }
          }
        },
        "features": {
          "type": "object",
          "description": "v0.12 features, all off by default (see values.yaml and the README, \"Features in v0.12.0\")",
          "properties": {
            "prePull": {"type": "boolean", "description": "Pull the models the enabled features load in an init container (dakera models pull configured)"},
            "persistModelCache": {"type": "boolean", "description": "Keep the model cache on a PVC while a feature that needs models is enabled"},
            "multilingual": {
              "type": "object",
              "description": "bge-m3, per-language full-text, CJK bigrams, multilingual query routing",
              "properties": {
                "enabled": {"type": "boolean"},
                "fulltextLanguage": {"type": "string", "description": "DAKERA_FULLTEXT_LANGUAGE"},
                "cjkBigrams": {"type": "string", "enum": ["", "true", "false"], "description": "DAKERA_FULLTEXT_CJK_BIGRAMS (empty follows the language)"},
                "queryLang": {"type": "string", "enum": ["", "auto", "en", "de", "fr", "es", "it", "pt", "nl"], "description": "DAKERA_QUERY_LANG"},
                "maxSeqLength": {"type": ["string", "integer"], "pattern": "^[0-9]*$", "minimum": 16, "description": "DAKERA_MAX_SEQ_LENGTH"}
              }
            },
            "multimodal": {
              "type": "object",
              "description": "Attachments and speech to text",
              "properties": {
                "enabled": {"type": "boolean"},
                "attachmentMaxBytes": {"type": ["string", "integer"], "pattern": "^[0-9]*$", "minimum": 1, "description": "DAKERA_ATTACHMENT_MAX_BYTES"},
                "memHighWaterFraction": {"type": ["string", "number"], "exclusiveMinimum": 0, "maximum": 1, "description": "DAKERA_MEM_HIGH_WATER_FRACTION, a number in (0, 1]"},
                "resources": {"type": "object", "description": "Used instead of dakera.resources while the feature is on"}
              }
            },
            "vision": {
              "type": "object",
              "description": "Image / page indexing and visual recall (a dedicated store)",
              "properties": {
                "enabled": {"type": "boolean"},
                "resources": {"type": "object", "description": "Used instead of dakera.resources while the feature is on"}
              }
            },
            "records": {
              "type": "object",
              "description": "Multi-vector records",
              "properties": {
                "enabled": {"type": "boolean"},
                "maxVectors": {"type": ["string", "integer"], "pattern": "^[0-9]*$", "minimum": 1, "description": "DAKERA_RECORD_MAX_VECTORS"},
                "maxBytes": {"type": ["string", "integer"], "pattern": "^[0-9]*$", "minimum": 1, "description": "DAKERA_RECORD_MAX_BYTES"}
              }
            },
            "lateInteraction": {
              "type": "object",
              "description": "colbert-small + MaxSim",
              "properties": {"enabled": {"type": "boolean"}}
            },
            "rabitq": {
              "type": "object",
              "description": "RaBitQ search mode",
              "properties": {
                "enabled": {"type": "boolean"},
                "bits": {"type": ["string", "integer"], "pattern": "^[1-8]?$", "minimum": 1, "maximum": 8, "description": "DAKERA_RABITQ_BITS, 1-8"}
              }
            }
          }
        },
        "podSecurityContext": {"type": "object", "description": "Pod security context (fsGroup 1000 by default)"},
        "readOnlyRootFilesystem": {"type": "boolean", "description": "Read-only root filesystem for the server container"},
        "persistence": {
          "type": "object",
          "description": "Persistent volume for the data root",
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "description": "PVC size (e.g. 20Gi)"},
            "storageClass": {"type": "string", "description": "StorageClass name — empty uses cluster default"}
          }
        },
        "resources": {
          "type": "object",
          "description": "CPU and memory resource requests/limits",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {"type": "string"},
                "memory": {"type": "string"}
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {"type": "string"},
                "memory": {"type": "string"}
              }
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "description": "Horizontal Pod Autoscaler configuration",
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100},
            "targetMemoryUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "service": {
          "type": "object",
          "description": "Kubernetes Service configuration",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "httpPort": {"type": "integer"},
            "grpcPort": {"type": "integer"}
          }
        }
      },
      "required": []
    },
    "rollback": {
      "type": "object",
      "description": "Optional one-off Job that runs `dakera downgrade` (rollback to v0.11.108)",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "description": "Image for the Job; default: the server image"},
        "ttlSecondsAfterFinished": {"type": "integer"}
      }
    },
    "dashboard": {
      "type": "object",
      "description": "Dakera Dashboard UI configuration",
      "properties": {
        "enabled": {"type": "boolean", "description": "Enable the dashboard component"},
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "replicaCount": {"type": "integer", "minimum": 1},
        "resources": {
          "type": "object",
          "properties": {
            "requests": {"type": "object", "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}},
            "limits": {"type": "object", "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}}
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer"}
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "description": "Dakera MCP (Model Context Protocol) server configuration",
      "properties": {
        "enabled": {"type": "boolean", "description": "Enable the MCP server component"},
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "replicaCount": {"type": "integer", "minimum": 1},
        "config": {
          "type": "object",
          "properties": {
            "port": {"type": "integer", "description": "MCP server port"}
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {"type": "object", "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}},
            "limits": {"type": "object", "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}}
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer"}
          }
        }
      }
    },
    "minio": {
      "type": "object",
      "description": "Built-in MinIO S3-compatible storage. Set enabled: false to use external S3.",
      "properties": {
        "enabled": {"type": "boolean", "description": "Enable built-in MinIO. Disable to use external S3."},
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "rootUser": {"type": "string", "description": "MinIO root username"},
        "rootPassword": {"type": "string", "description": "MinIO root password — REQUIRED when minio.enabled is true"},
        "persistence": {
          "type": "object",
          "properties": {
            "size": {"type": "string", "description": "PVC size (e.g. 50Gi)"},
            "storageClass": {"type": "string"}
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {"type": "object", "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}},
            "limits": {"type": "object", "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "description": "Kubernetes Ingress configuration for external access",
      "properties": {
        "enabled": {"type": "boolean", "description": "Enable Ingress resources"},
        "className": {"type": "string", "description": "Ingress class name (e.g. nginx, traefik)"},
        "apiHost": {"type": "string", "description": "Hostname for the Dakera API (e.g. api.dakera.yourdomain.com)"},
        "dashboardHost": {"type": "string", "description": "Hostname for the dashboard"},
        "mcpHost": {"type": "string", "description": "Hostname for the MCP server"},
        "annotations": {
          "type": "object",
          "description": "Ingress annotations (e.g. cert-manager.io/cluster-issuer)",
          "additionalProperties": {"type": "string"}
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration blocks",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {"type": "string"},
              "hosts": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "description": "Prometheus + Grafana monitoring stack",
      "properties": {
        "enabled": {"type": "boolean", "description": "Enable monitoring components (no templates: use prometheusRule / grafanaDashboard below)"},
        "prometheusRule": {
          "type": "object",
          "description": "The server's v0.12 alert rules as a Prometheus Operator PrometheusRule",
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object", "description": "Extra labels (your Prometheus' ruleSelector)"}
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "description": "The server's v0.12 dashboard as a ConfigMap for Grafana's dashboard sidecar",
          "properties": {
            "enabled": {"type": "boolean"},
            "label": {"type": "string"},
            "labelValue": {"type": "string"}
          }
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": {"type": "string"},
                "tag": {"type": "string"}
              }
            },
            "retention": {"type": "string", "description": "Data retention period (e.g. 15d)"},
            "persistence": {
              "type": "object",
              "properties": {
                "size": {"type": "string"},
                "storageClass": {"type": "string"}
              }
            }
          }
        },
        "grafana": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": {"type": "string"},
                "tag": {"type": "string"}
              }
            },
            "adminUser": {"type": "string", "description": "Grafana admin username"},
            "adminPassword": {"type": "string", "description": "Grafana admin password — auto-generated if empty"},
            "persistence": {
              "type": "object",
              "properties": {
                "size": {"type": "string"},
                "storageClass": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "description": "Global settings applied across all components",
      "properties": {
        "namespace": {"type": "string", "description": "Kubernetes namespace to deploy into"},
        "imagePullSecrets": {
          "type": "array",
          "description": "List of image pull secrets for private registries",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
